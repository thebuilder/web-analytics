<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- Umbraco 17 and 18 run on .NET 10, Umbraco 19 on .NET 11 only, so each target framework gets its own range. -->
    <UmbracoVersion Condition="'$(UmbracoVersion)' == '' and '$(TargetFramework)' == 'net11.0'">[19.0.0-rc1,20.0.0)</UmbracoVersion>
    <!-- Umbraco 19 is only out as a release candidate, so the net11.0 range starts at one, which NuGet
         warns about for a stable package. Remove this with the move to 19.0.0. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">[17.1.0,19.0.0)</UmbracoVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TheBuilder.WebAnalytics</PackageId>
    <Product>Web Analytics</Product>
    <Title>Web Analytics</Title>
    <Version>0.1.0</Version>
    <Authors>Daniel Schmidt</Authors>
    <Description>View Vercel and Plausible web analytics directly inside the Umbraco backoffice.</Description>
    <PackageTags>umbraco;umbraco-marketplace;analytics;web analytics;vercel;plausible;traffic;visitors;referrers;utm;dashboard;reporting;content analytics;page analytics;custom events;multi-site</PackageTags>
    <PackageProjectUrl>https://github.com/thebuilder/web-analytics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/web-analytics.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/thebuilder/web-analytics/releases for release notes.</PackageReleaseNotes>
    <BackofficeClientDirectory>$(MSBuildProjectDirectory)/Client</BackofficeClientDirectory>
    <BackofficeWorkspaceDirectory>$(MSBuildProjectDirectory)/../..</BackofficeWorkspaceDirectory>
    <BackofficeAssetsPattern>wwwroot/App_Plugins/TheBuilder.WebAnalytics/**/*</BackofficeAssetsPattern>
    <BackofficeAssetsDirectory>$(MSBuildProjectDirectory)/wwwroot/App_Plugins/TheBuilder.WebAnalytics</BackofficeAssetsDirectory>
    <BackofficeManifest>$(BackofficeAssetsDirectory)/umbraco-package.json</BackofficeManifest>
    <BackofficeEntryPoint>$(BackofficeAssetsDirectory)/web-dashboard.js</BackofficeEntryPoint>
    <BackofficeBuildStamp>$(MSBuildProjectDirectory)/obj/backoffice-$(Version).stamp</BackofficeBuildStamp>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersion)" />
  </ItemGroup>

  <!-- Keep these at or above the versions Umbraco 17 and 18's transitive graph requires
       so restore does not report vulnerable or downgraded transitive packages.
       Umbraco 19 already requires newer versions. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />
    <!-- Hashed Vite chunks are refreshed immediately before static-web-asset discovery. -->
    <Content Remove="wwwroot/App_Plugins/TheBuilder.WebAnalytics/**/*" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\umbraco-package.json" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
    <InternalsVisibleTo Include="TheBuilder.WebAnalytics.Tests" />
    <BackofficeBuildInput Include="$(BackofficeClientDirectory)/src/**/*" />
    <BackofficeBuildInput Include="$(BackofficeClientDirectory)/package.json" />
    <BackofficeBuildInput Include="$(BackofficeClientDirectory)/tsconfig.json" />
    <BackofficeBuildInput Include="$(BackofficeClientDirectory)/vite.config.ts" />
    <BackofficeBuildInput Include="$(BackofficeClientDirectory)/umbraco-package.json" />
    <BackofficeBuildInput Include="$(MSBuildProjectDirectory)/../../pnpm-lock.yaml" />
  </ItemGroup>

  <!-- The project packs for .NET 10 and .NET 11, and the two framework builds run in parallel. The client is built
       once, in the outer build before them, so one cannot empty the output folder while the other packs it. -->
  <Target Name="BuildBackofficeAssetsForPack"
          BeforeTargets="DispatchToInnerBuilds"
          Condition="'$(_IsPacking)' == 'true' and '$(NoBuild)' != 'true' and '$(TargetFramework)' == ''"
          Inputs="@(BackofficeBuildInput)"
          Outputs="$(BackofficeManifest);$(BackofficeEntryPoint);$(BackofficeBuildStamp)">
    <Exec Command="corepack pnpm --filter thebuilder-web-analytics build"
          WorkingDirectory="$(BackofficeWorkspaceDirectory)"
          EnvironmentVariables="PACKAGE_VERSION=$(Version)" />
    <Touch Files="$(BackofficeBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="RefreshBackofficeStaticWebAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="BuildBackofficeAssetsForPack">
    <ItemGroup>
      <Content Include="$(BackofficeAssetsPattern)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateBackofficeAssetsForPack"
          BeforeTargets="IncludeStaticWebAssetsPackItems"
          Condition="'$(_IsPacking)' == 'true'">
    <Error Condition="!Exists('$(BackofficeManifest)')"
           Text="Cannot pack TheBuilder.WebAnalytics because the backoffice manifest is missing. Build the client first." />
    <Error Condition="!Exists('$(BackofficeEntryPoint)')"
           Text="Cannot pack TheBuilder.WebAnalytics because the backoffice entry point is missing. Build the client first." />
  </Target>

</Project>
