---
// @ts-nocheck — This static page's markup type-checks against React's global
// JSX namespace (pulled in transitively by blume's React-island types), which
// flags valid Astro attributes like `class` and string `style`. The page builds
// and renders correctly; skip type-checking to avoid the false positives.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

import "./_home/home.css";

import overviewShot from "../docs/screenshots/analytics-overview.png";
import documentShot from "../docs/screenshots/document-analytics-workspace.png";
import settingsShot from "../docs/screenshots/settings.png";

const { config } = data;

const repoUrl = "https://github.com/thebuilder/web-analytics";
const nugetUrl = "https://www.nuget.org/packages/TheBuilder.WebAnalytics";
const marketplaceUrl =
  "https://marketplace.umbraco.com/package/thebuilder.webanalytics";
const installCommand = "dotnet add package TheBuilder.WebAnalytics";

const providers = [
  {
    name: "Vercel Web Analytics",
    href: "/providers/vercel",
    detail:
      "Connect a Vercel project with a scoped access token. Read visitors, page views, routes, and campaigns without ever storing the token in Umbraco.",
  },
  {
    name: "Plausible",
    href: "/providers/plausible",
    detail:
      "Point at Plausible Cloud or a self-hosted instance with a Stats API key. Explore events, properties, and privacy-friendly traffic from the backoffice.",
  },
];

const features = [
  {
    title: "Traffic reports",
    body: "Visitors, page views, trends, acquisition, audience, pages, routes, and campaigns: the headline numbers, one click away.",
    icon: "chart",
  },
  {
    title: "Document context",
    body: "See analytics inside a published document's workspace, automatically scoped to that document's route.",
    icon: "doc",
  },
  {
    title: "Drill into detail",
    body: "Compare date ranges, apply filters, and follow a headline number down to the context behind it.",
    icon: "filter",
  },
  {
    title: "Multi-site support",
    body: "Add more than one connection to a single Umbraco installation and switch between them.",
    icon: "layers",
  },
  {
    title: "Private credentials",
    body: "Provider access lives in server-side configuration, never in the browser, never in Umbraco content.",
    icon: "lock",
  },
  {
    title: "No tracking changes",
    body: "Reads the data your provider already collects. It never installs, replaces, or configures tracking on your public site.",
    icon: "shield",
  },
];

const steps = [
  {
    title: "Install the package",
    body: "Add TheBuilder.WebAnalytics to your Umbraco web project. Services and backoffice extensions register automatically.",
  },
  {
    title: "Configure a credential",
    body: "Store a read-only Vercel or Plausible credential in server-side secret configuration.",
  },
  {
    title: "Connect and test",
    body: "Add a connection at Settings → Web Analytics, run Test connection, and open the Analytics dashboard.",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/opengraph-image.png"
  page={{
    title: "Web Analytics for Umbraco",
    description:
      "Bring Vercel Web Analytics and Plausible reports into the Umbraco backoffice: site-wide and page-level traffic where editors already work.",
    route: "/",
  }}
>
  <div class="home" data-home>
    {/* Hero */}
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="shell hero__inner">
        <img
          class="hero__mark reveal"
          src="/logo.png"
          width="72"
          height="72"
          alt="Web Analytics"
          style="--i: 0"
          decoding="async"
        />
        <h1 class="hero__title reveal" style="--i: 1">
          Your site's traffic,{" "}
          <span class="hero__accent">right inside Umbraco</span>.
        </h1>
        <p class="hero__lede reveal" style="--i: 2">
          Web Analytics brings Vercel Web Analytics and Plausible reports into the
          backoffice. Editors understand site-wide traffic and the performance of
          the page they're working on, without leaving Umbraco or learning another
          dashboard.
        </p>
        <div class="hero__actions reveal" style="--i: 3">
          <a class="btn btn--primary" href="/quickstart">Get started</a>
          <a class="btn btn--ghost" href={repoUrl} rel="noopener">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
              <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.23 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.83 1.28.83 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"></path>
            </svg>
            View on GitHub
          </a>
        </div>
        <div class="install reveal" style="--i: 4">
          <span class="install__prompt" aria-hidden="true">$</span>
          <code class="install__code">{installCommand}</code>
          <button class="install__copy" type="button" data-copy={installCommand} aria-label="Copy install command">
            <svg class="install__icon install__icon--copy" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg class="install__icon install__icon--done" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
        </div>
        <p class="hero__compat reveal" style="--i: 5">
          Supports Umbraco CMS 17.1 through 18.x
        </p>
      </div>

      <div class="shell">
        <figure class="shot shot--hero reveal" style="--i: 5">
          <div class="shot__bar" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <img
            src={overviewShot.src}
            width={overviewShot.width}
            height={overviewShot.height}
            alt="The Web Analytics dashboard in the Umbraco backoffice, showing visitors, page views, and traffic trends."
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    {/* Trust line */}
    <section class="shell trust reveal">
      <p>
        <strong>Reads the analytics you already collect.</strong>{" "}
        No new tracking added to your public site, no credentials in the browser,
        no separate platform to learn.
      </p>
    </section>

    {/* Providers */}
    <section class="shell home-block">
      <div class="home-block__head reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2>Works with the analytics you already run</h2>
        <p>Bring your existing provider. Reporting depth adapts to what each one exposes; the editorial experience stays the same.</p>
      </div>
      <div class="providers">
        {providers.map((provider, index) => (
          <a class="provider reveal" href={provider.href} style={`--i: ${index + 1}`}>
            <h3>{provider.name}</h3>
            <p>{provider.detail}</p>
            <span class="provider__link">
              Reference
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    {/* Features */}
    <section class="shell home-block">
      <div class="home-block__head reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2>Insight where editors already work</h2>
        <p>The traffic signals that matter for the current editorial task, within immediate reach, with nothing more to configure.</p>
      </div>
      <div class="features">
        {features.map((feature, index) => (
          <article class="feature reveal" style={`--i: ${index + 1}`}>
            <span class="feature__icon" aria-hidden="true">
              {feature.icon === "chart" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><rect x="7" y="11" width="3" height="6"></rect><rect x="12" y="7" width="3" height="10"></rect><rect x="17" y="13" width="3" height="4"></rect></svg>
              )}
              {feature.icon === "doc" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"></path><path d="M9 13h6M9 17h4"></path></svg>
              )}
              {feature.icon === "filter" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h18l-7 8v6l-4 2v-8L3 4Z"></path></svg>
              )}
              {feature.icon === "layers" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path></svg>
              )}
              {feature.icon === "lock" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
              )}
              {feature.icon === "shield" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
              )}
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    {/* Document analytics split */}
    <section class="shell home-block">
      <div class="split">
        <div class="split__copy reveal">
          <span class="rule" aria-hidden="true"></span>
          <h2>Page performance, next to the content</h2>
          <p>
            Map a document root and Web Analytics adds an Analytics workspace to
            published documents, automatically filtered to that page's route.
            Editors see how the page they're editing actually performs, without
            hunting for it in a separate report.
          </p>
          <a class="btn btn--ghost" href="/guides/document-analytics">
            Read the guide
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
        <figure class="shot reveal" style="--i: 1">
          <div class="shot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <img
            src={documentShot.src}
            width={documentShot.width}
            height={documentShot.height}
            alt="The Analytics workspace shown on a published document, scoped to that page's route."
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    {/* Steps */}
    <section class="shell home-block">
      <div class="home-block__head reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2>Connected in three steps</h2>
        <p>From package install to a working dashboard, the whole path lives on one <a href="/quickstart">quickstart</a> page.</p>
      </div>
      <div class="steps-grid">
        <ol class="steps">
          {steps.map((step, index) => (
            <li class="step reveal" style={`--i: ${index + 1}`}>
              <span class="step__num" aria-hidden="true">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <figure class="shot reveal" style="--i: 2">
          <div class="shot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <img
            src={settingsShot.src}
            width={settingsShot.width}
            height={settingsShot.height}
            alt="The Web Analytics connection settings screen in Umbraco, with Test connection."
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    {/* Closing CTA */}
    <section class="shell home-block">
      <div class="cta reveal">
        <div class="cta__glow" aria-hidden="true"></div>
        <h2>Bring analytics into the editorial workflow</h2>
        <p>Install the package, connect the provider your site already uses, and give editors traffic context where they manage content.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/quickstart">Get started</a>
          <a class="btn btn--ghost btn--on-panel" href={marketplaceUrl} rel="noopener">Umbraco Marketplace</a>
        </div>
      </div>
    </section>
  </div>

  {/* Footer */}
  <footer class="home-footer" slot="footer">
    <div class="shell home-footer__inner">
      <div class="home-footer__brand">
        <span class="home-footer__name">{config.title}</span>
        <span class="home-footer__meta">
          MIT licensed · built by{" "}
          <a href="https://github.com/thebuilder" rel="noopener">thebuilder</a>
        </span>
      </div>
      <nav class="home-footer__nav" aria-label="Footer">
        <a href="/overview">Docs</a>
        <a href={repoUrl} rel="noopener">GitHub</a>
        <a href={nugetUrl} rel="noopener">NuGet</a>
      </nav>
    </div>
  </footer>
</PageLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-home]");
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && !prefersReduced && "IntersectionObserver" in window) {
    root.classList.add("home--motion");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    for (const el of root.querySelectorAll(".reveal")) observer.observe(el);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".install__copy")) {
    button.addEventListener("click", async () => {
      const text = button.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        button.classList.add("is-copied");
        window.setTimeout(() => button.classList.remove("is-copied"), 1600);
      } catch {
        /* clipboard unavailable, ignore */
      }
    });
  }
</script>
