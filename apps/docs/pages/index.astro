---
// @ts-nocheck — This static page's markup type-checks against React's global
// JSX namespace (pulled in transitively by blume's React-island types), which
// flags valid Astro attributes like `class` and string `style`. The page builds
// and renders correctly; skip type-checking to avoid the false positives.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import { loadUmbracoPackages } from "@thebuilder/umbraco-docs";
import {
  EcosystemSection,
  InstallCommand,
  LandingHero,
  LandingRoot,
} from "@thebuilder/umbraco-docs/astro";
import HeroParticles from "@thebuilder/umbraco-docs/components/HeroParticles";

import "./_home/home.css";

import overviewShot from "../docs/screenshots/analytics-overview.png";
import documentShot from "../docs/screenshots/document-analytics-workspace.png";
import settingsShot from "../docs/screenshots/settings.png";
import { webAnalyticsPackage } from "../umbraco-package";

// The other packages come from the hub at umbraco.thebuilder.dk, so this list never needs editing here.
const ecosystemPackages = await loadUmbracoPackages();

const { config } = data;

const repoUrl = webAnalyticsPackage.links.github;
const nugetUrl = webAnalyticsPackage.links.nuget;
const marketplaceUrl = webAnalyticsPackage.links.marketplace;
const installCommand = "dotnet add package TheBuilder.WebAnalytics";

const providers = [
  {
    name: "Vercel Web Analytics",
    href: "/providers/vercel",
    detail:
      "Connect a Vercel project with a scoped access token. Visitors, page views, pages, campaigns, custom events, and feature flags, with the token never stored in Umbraco.",
  },
  {
    name: "Plausible",
    href: "/providers/plausible",
    detail:
      "Point at Plausible Cloud or a self-hosted instance with a Stats API key. Adds global event filtering and custom event properties on top of the core reports.",
  },
];

const features = [
  {
    title: "Traffic reports",
    body: "Visitors and page views over time, plus pages, referrers, campaigns, countries, devices, browsers, and operating systems.",
    icon: "chart",
  },
  {
    title: "Document context",
    body: "An Analytics view inside a published document's workspace, filtered to that document's route. Toggle child paths to cover the whole section.",
    icon: "doc",
  },
  {
    title: "Compare and filter",
    body: "Each metric shows how it moved against the period before it. Turn any breakdown row into a filter across the whole dashboard.",
    icon: "filter",
  },
  {
    title: "Multi-site support",
    body: "Connect several Vercel projects and Plausible sites to one Umbraco installation and switch between them.",
    icon: "layers",
  },
  {
    title: "Private credentials",
    body: "Tokens live in server-side configuration. They are never written to Umbraco and never sent to the browser.",
    icon: "lock",
  },
  {
    title: "No tracking changes",
    body: "Reads the data your provider already collects. It never installs, replaces, or configures tracking on your public site.",
    icon: "shield",
  },
];

const steps = [
  {
    title: "Install the package",
    body: "Add TheBuilder.WebAnalytics to your Umbraco web project. Services and backoffice extensions register automatically.",
  },
  {
    title: "Configure a credential",
    body: "Store a read-only Vercel or Plausible credential in server-side secret configuration.",
  },
  {
    title: "Connect and test",
    body: "Add a connection at Settings → Web Analytics, run Test connection, and open the Analytics dashboard.",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og/index.png"
  page={{
    title: "Web Analytics for Umbraco",
    description:
      "Vercel Web Analytics and Plausible reports inside the Umbraco backoffice, site-wide and per page, with no new tracking on your public site.",
    route: "/",
  }}
>
  <LandingRoot class="home">
    <LandingHero
      layout="split"
      title="Your site's traffic,"
      accent="right inside Umbraco."
      description="Web Analytics reads the traffic your site already sends to Vercel or Plausible and reports it in the backoffice. Editors see the site-wide numbers and how the page they're editing is doing, without leaving Umbraco."
      compatibility="Supports Umbraco CMS 17.1 through 18.x"
    >
      <HeroParticles slot="background" logo="/logo-mark.svg" />
      <Fragment slot="actions">
        <a class="button button--primary" href="/quickstart">Get started</a>
        <a class="button button--secondary" href={repoUrl} rel="noopener">View on GitHub</a>
      </Fragment>
      <InstallCommand slot="install" command={installCommand} />
      <div class="shell">
        <figure class="shot shot--hero reveal" style="--i: 6">
          <div class="shot__bar" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <img
            src={overviewShot.src}
            width={overviewShot.width}
            height={overviewShot.height}
            alt="The Web Analytics dashboard in the Umbraco backoffice, showing visitors, page views, and traffic trends."
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </LandingHero>

    {/* Trust line */}
    <section class="shell trust reveal">
      <p>
        <strong>Nothing new on your public site.</strong>{" "}
        Web Analytics only reads. Tracking on your site stays exactly as you set
        it up, and the token never leaves server-side configuration.
      </p>
    </section>

    {/* Providers */}
    <section class="shell home-block">
      <div class="home-block__head reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2>Bring your own provider</h2>
        <p>Point it at a Vercel project or a Plausible site. Where a provider can't report something, the backoffice hides that panel instead of showing an error.</p>
      </div>
      <div class="providers">
        {providers.map((provider, index) => (
          <a class="provider reveal" href={provider.href} style={`--i: ${index + 1}`}>
            <h3>{provider.name}</h3>
            <p>{provider.detail}</p>
            <span class="provider__link">
              Reference
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    {/* Features */}
    <section class="shell home-block">
      <div class="home-block__head reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2>What's in the dashboard</h2>
        <p>One dashboard per connection, and the same reports again on any document you map.</p>
      </div>
      <div class="features">
        {features.map((feature, index) => (
          <article class="feature reveal" style={`--i: ${index + 1}`}>
            <span class="feature__icon" aria-hidden="true">
              {feature.icon === "chart" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><rect x="7" y="11" width="3" height="6"></rect><rect x="12" y="7" width="3" height="10"></rect><rect x="17" y="13" width="3" height="4"></rect></svg>
              )}
              {feature.icon === "doc" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"></path><path d="M9 13h6M9 17h4"></path></svg>
              )}
              {feature.icon === "filter" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h18l-7 8v6l-4 2v-8L3 4Z"></path></svg>
              )}
              {feature.icon === "layers" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path></svg>
              )}
              {feature.icon === "lock" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
              )}
              {feature.icon === "shield" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
              )}
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    {/* Document analytics split */}
    <section class="shell home-block">
      <div class="split">
        <div class="split__copy reveal">
          <span class="rule" aria-hidden="true"></span>
          <h2>Page performance, next to the content</h2>
          <p>
            Map a document root and every published document below it gains an
            Analytics workspace, filtered to its own route. It follows Umbraco's
            Content permissions, so an editor who can browse a page can read its
            numbers without access to the global Analytics section.
          </p>
          <a class="button button--secondary" href="/guides/document-analytics">
            Read the guide
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
        <figure class="shot reveal" style="--i: 1">
          <div class="shot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <img
            src={documentShot.src}
            width={documentShot.width}
            height={documentShot.height}
            alt="The Analytics workspace shown on a published document, scoped to that page's route."
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    {/* Steps */}
    <section class="shell home-block">
      <div class="home-block__head reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2>Connected in three steps</h2>
        <p>All three steps, and what to check afterwards, are on the <a href="/quickstart">quickstart</a> page.</p>
      </div>
      <div class="steps-grid">
        <ol class="steps">
          {steps.map((step, index) => (
            <li class="step reveal" style={`--i: ${index + 1}`}>
              <span class="step__num" aria-hidden="true">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <figure class="shot reveal" style="--i: 2">
          <div class="shot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <img
            src={settingsShot.src}
            width={settingsShot.width}
            height={settingsShot.height}
            alt="The Web Analytics connection settings screen in Umbraco, with Test connection."
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    {/* Closing CTA */}
    <section class="shell home-block">
      <div class="cta reveal">
        <div class="cta__glow" aria-hidden="true"></div>
        <h2>Put the numbers where the content is</h2>
        <p>Install the package, point it at your Vercel project or Plausible site, and editors get their traffic reports without a second login.</p>
        <div class="cta__actions">
          <a class="button button--primary" href="/quickstart">Get started</a>
          <a class="button button--secondary" href={marketplaceUrl} rel="noopener">Umbraco Marketplace</a>
        </div>
      </div>
    </section>

    <EcosystemSection
      packages={ecosystemPackages}
      currentPackageId={webAnalyticsPackage.id}
    />
  </LandingRoot>

  {/* Footer */}
  <footer class="home-footer" slot="footer">
    <div class="shell home-footer__inner">
      <div class="home-footer__brand">
        <span class="home-footer__name">{config.title}</span>
        <span class="home-footer__meta">
          MIT licensed · built by{" "}
          <a href="https://github.com/thebuilder" rel="noopener">thebuilder</a>
        </span>
      </div>
      <nav class="home-footer__nav" aria-label="Footer">
        <a href="/overview">Docs</a>
        <a href={repoUrl} rel="noopener">GitHub</a>
        <a href={nugetUrl} rel="noopener">NuGet</a>
        <a href={marketplaceUrl} rel="noopener">Marketplace</a>
      </nav>
    </div>
  </footer>
</PageLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-udocs-root]");
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && !prefersReduced && "IntersectionObserver" in window) {
    root.classList.add("home--motion");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    for (const el of root.querySelectorAll(".reveal")) observer.observe(el);
  }
</script>
